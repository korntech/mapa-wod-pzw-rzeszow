{
  "name": "mapa-wod-pzw-rzeszow",
  "version": "2.0.0",
  "private": true,
  "description": "Mapa wód PZW Okręgu w Rzeszowie — dane z wykazu Okręgu i BDOT10k (GUGiK)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "export": "node tools/snapshot/export.mjs",
    "validate": "node tools/snapshot/validate.mjs",
    "seed-sql": "node tools/snapshot/seed-sql.mjs",
    "test": "node --test",
    "check": "node --check vite.config.js && for f in tools/snapshot/*.mjs tools/triage/*.mjs; do node --check \"$f\" || exit 1; done && npm run validate && npm test"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.18.3",
    "@supabase/supabase-js": "^2.45.0",
    "leaflet": "^1.9.4",
    "proj4": "^2.22.0",
    "proj4leaflet": "^1.0.2"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
