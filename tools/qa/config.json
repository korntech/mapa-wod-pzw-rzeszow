      ]
    },
    "zasady_naglowek": "^\\s*obowi[aą]zuj[aą]ce\\s+zasady\\s*:?\\s*$",
    "ciag_dalszy_ze": "ci[aąq]\\w*\\s+dalsz\\w*\\s+ze\\s+str\\.?\\s*\\d*\\.?",
    "ciag_dalszy_na": "ci[aąq]\\w*\\s+dalsz\\w*\\s+na\\s+str\\.?\\s*\\d*\\.?",
    "poczatek_punktu": "^\\s*([-–*•]|\\d+\\.)\\s*",
    "ha_bez_separatora_dwa_miejsca": true,
    "prefiks_zbiornikow": "^\\s*zbiornik[i]?\\s*:?\\s*",
    "poprawki_ocr": [
      [
        "(?m)(?<=\\S)\\s*\\|\\s*$",
        " I"
      ],
      [
        "\\s*[|]\\s*",
        " "
      ],
      [
        "\\bIll\\b",
        "III"
      ],
      [
        "\\bIl\\b",
        "II"
      ],
      [
        "\\bIi\\b",
        "I i"
      ],
      [
        "\\bli\\b",
        "I i"
      ],
      [
        "(?:\\b|[(GQ])ałkowit[yv]",
        "Całkowity"
      ],
      [
        "\\bśpinningowa",
        "spinningowa"
      ],
      [
        "\\bsie\\b",
        "się"
      ],
      [
        "\\bwm\\.",
        "w m."
      ],
      [
        "[„”“]",
        "\""
      ],
      [
        "[’‘]",
        "'"
      ],
      [
        "(?<=\\d)\\s*i\\s*(?=\\d)",
        " i "
      ],
      [
        "\\b([Nn]r)(?=\\d)",
        "\\1 "
      ],
      [
        "_{2,}",
        " "
      ],
      [
        "[ \\t]+",
        " "
      ]
    ],
    "koniec_punktu": "(?:(?<!\\btj)(?<!\\bm)(?<!\\bnp)(?<!\\bzb)(?<!\\bul)(?<!\\bgodz)(?<!\\bmłp)\\.|[:;)])$"
  },
  "porownanie": {
